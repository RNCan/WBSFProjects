{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25
  },
  "configurePresets": [
    {
      "name": "base-preset",
      "displayName": "base-preset",            
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",        
        "CMAKE_CXX_FLAGS": "-DBUILDING_FROM_VCPKG=1",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/package"
      }
    },
    {
      "name": "vs2022",
      "inherits": "base-preset",
      "architecture": "x64",
      "displayName": "Visual Studio 2022 (vcpkg + x64)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VCPKG_FEATURE_FLAGS": "manifests"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base-preset",
      "generator": "Unix Makefiles",
      "displayName": "VCPKG Build Linux",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base-preset",
      "generator": "Unix Makefiles",
      "displayName": "VCPKG Build Linux",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022",
      "configurePreset": "vs2022"
    }
  ]
}
