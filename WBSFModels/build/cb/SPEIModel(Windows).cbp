<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="StdPrcpETIndex" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debugx64/SPEI.dll" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Debugx64/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-fPIC" />
					<Add option="-m64" />
					<Add option="-g" />
					<Add option="-std=gnu++20" />
					<Add option="-ggdb" />
					<Add directory="../../../WBSF/src" />
				</Compiler>
				<Linker>
					<Add option="-m64" />
					<Add library="libModelBased.a" />
					<Add library="libWeatherBased.a" />
					<Add library="libBasic.a" />
					<Add library="libboost_filesystem-mt.a" />
					<Add library="libboost_timer-mt.a" />
					<Add library="libboost_iostreams-mt.a" />
					<Add library="libboost_locale-mt.a" />
					<Add library="libboost_process-mt.a" />
					<Add library="libboost_serialization-mt.a" />
					<Add library="libgomp.a" />
					<Add library="libws2_32.a" />
					<Add directory="../../../WBSF/lib/Debugx64" />
				</Linker>
				<ExtraCommands>
					<Add after='xcopy /I /Y &quot;$(TARGET_OUTPUT_FILE)&quot; &quot;../../../WBSFInstall/Models/$(TARGET_OUTPUT_BASENAME).dll*&quot;' />
					<Mode after="always" />
				</ExtraCommands>
			</Target>
			<Target title="Release">
				<Option output="bin/Releasex64/SPEI.dll" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Releasex64/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add option="-fPIC" />
					<Add option="-m64" />
					<Add option="-std=gnu++20" />
					<Add directory="../../../WBSF/src" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-m64" />
					<Add library="libModelBased.a" />
					<Add library="libWeatherBased.a" />
					<Add library="libBasic.a" />
					<Add library="libboost_filesystem-mt.a" />
					<Add library="libboost_timer-mt.a" />
					<Add library="libboost_iostreams-mt.a" />
					<Add library="libboost_locale-mt.a" />
					<Add library="libboost_process-mt.a" />
					<Add library="libboost_serialization-mt.a" />
					<Add library="libgomp.a" />
					<Add library="libws2_32.a" />
					<Add directory="../../../WBSF/lib/Releasex64" />
				</Linker>
				<ExtraCommands>
					<Add after='xcopy /I /Y &quot;$(TARGET_OUTPUT_FILE)&quot; &quot;../../../WBSFInstall/Models/$(TARGET_OUTPUT_BASENAME).dll*&quot;' />
					<Mode after="always" />
				</ExtraCommands>
			</Target>
		</Build>
		<Unit filename="../../src/StdPrcpETIndex/CMakeLists.txt" />
